{
  "name": "@jeh-doces/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "test:smoke": "tsx --tsconfig tsconfig.json --test src/app.smoke.test.ts",
    "test:billing": "tsx --tsconfig tsconfig.json --test src/modules/billing/plan-limits.test.ts",
    "test:webhook": "tsx --tsconfig tsconfig.json --test src/modules/billing/webhook-signature.test.ts",
    "test:account": "tsx --tsconfig tsconfig.json --test src/modules/account/account.service.test.ts",
    "start": "prisma migrate deploy && tsx src/index.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:import-json": "tsx src/import-json.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@jeh-doces/shared": "*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.11.3",
    "nodemailer": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^7.0.12",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

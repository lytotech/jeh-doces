generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  owner
  admin
  employee
}

model Company {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invitations Invitation[]
  ingredients Ingredient[]
  materials   Material[]
  products    Product[]
  orders      Order[]
  setting     Setting?
  customers   Customer[]
  commitments Commitment[]
  stockMovements MaterialStockMovement[]
  catalogCategories CatalogCategory[]
  subscription Subscription?
  deletionRequestedAt DateTime?
  deletionScheduledFor DateTime?
  deactivatedAt DateTime?

  @@index([deletionScheduledFor])

  @@map("companies")
}

enum SubscriptionPlan {
  basic
  monthly
  annual
}

enum SubscriptionStatus {
  active
  pending
  past_due
  canceled
}

model Subscription {
  id                String             @id @default(cuid())
  companyId         String             @unique
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan  @default(basic)
  status            SubscriptionStatus @default(active)
  currentPeriodEnd  DateTime?
  mercadoPagoId     String?
  pendingPaymentId  String?
  pendingPlan       SubscriptionPlan?
  payments          SubscriptionPayment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id              String           @id @default(cuid())
  subscriptionId  String
  subscription    Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  mercadoPagoId   String           @unique
  plan            SubscriptionPlan
  amount          Float
  status          String
  paidAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_payments")
}

enum CatalogCategoryType {
  product
  material
}

model CatalogCategory {
  id        String             @id @default(cuid())
  name      String
  type      CatalogCategoryType
  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([companyId, type, name])
  @@index([companyId, type, name])
  @@map("catalog_categories")
}

model User {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  passwordHash  String
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   Membership[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  verificationTokens EmailVerificationToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(employee)
  createdAt DateTime    @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  email     String
  role      CompanyRole @default(employee)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([companyId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Ingredient {
  id              String         @id @default(cuid())
  name            String
  isComposite     Boolean        @default(false)
  unit            String         @default("g") // g, ml, un
  packageQuantity Float          @default(1000)
  paidPrice       Float          @default(0)
  unitCost        Float          @default(0)
  yieldQuantity   Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  priceHistory    PriceHistory[]
  subIngredients  SubIngredient[] @relation("CompositeParent")
  usedInComposite SubIngredient[] @relation("SubIngredientItem")
  productItems    ProductIngredient[]

  @@map("ingredients")
  @@index([companyId])
}

model PriceHistory {
  id              String     @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  date            DateTime   @default(now())
  paidPrice       Float
  packageQuantity Float
  unitCost        Float
  notes           String?
  createdAt       DateTime   @default(now())

  @@map("price_history")
}

model SubIngredient {
  id             String     @id @default(cuid())
  parentId       String
  parent         Ingredient @relation("CompositeParent", fields: [parentId], references: [id], onDelete: Cascade)
  ingredientId   String
  subIngredient  Ingredient @relation("SubIngredientItem", fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity       Float

  @@map("sub_ingredients")
}

model Material {
  id            String          @id @default(cuid())
  name          String
  category      String          @default("Geral")
  unit          String          @default("un")
  baseQuantity  Float           @default(1)
  totalCost     Float           @default(0)
  unitCost      Float           @default(0)
  trackStock    Boolean         @default(true)
  stockQuantity Float           @default(0)
  minStockAlert Float?          @default(5)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productItems  ProductMaterial[]
  orderItems    OrderMaterial[]
  stockMovements MaterialStockMovement[]

  @@map("materials")
  @@index([companyId])
}

model MaterialStockMovement {
  id             String   @id @default(cuid())
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quantityDelta  Float
  stockBefore    Float
  stockAfter     Float
  reason         String
  createdAt      DateTime @default(now())

  @@index([companyId, materialId, createdAt])
  @@map("material_stock_movements")
}

model Product {
  id             String              @id @default(cuid())
  name           String
  category       String              @default("Geral")
  description    String?
  icon           String?             @default("🧁")
  salePrice      Float               @default(0)
  calculatedCost Float               @default(0)
  profitMargin   Float               @default(100)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ingredients    ProductIngredient[]
  materials      ProductMaterial[]
  orderItems     OrderItem[]

  @@map("products")
  @@index([companyId])
}

model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float

  @@map("product_ingredients")
}

model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float

  @@map("product_materials")
}

enum OrderStatus {
  orcamento
  confirmado
  produzindo
  pronto
  entregue
  cancelado
}

model Order {
  id                  String          @id @default(cuid())
  orderNumber         String
  deliveryDate        DateTime
  status              OrderStatus     @default(orcamento)
  subtotal            Float           @default(0)
  discount            Float           @default(0)
  totalCharged        Float           @default(0)
  estimatedCost       Float           @default(0)
  estimatedProfit     Float           @default(0)
  profitMarginPercent Float           @default(0)
  notes               String?
  stockDecremented    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientName          String?
  clientPhone         String?
  clientAddress       String?
  shareToken           String?         @unique

  items               OrderItem[]
  materials           OrderMaterial[]
  payments            Payment[]

  @@map("orders")
  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([companyId, archivedAt])
  @@index([companyId, name])
  @@map("customers")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
  unitCost    Float    @default(0)
  totalCost   Float    @default(0)

  @@map("order_items")
}

model OrderMaterial {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Float    @default(1)
  unitCost     Float    @default(0)
  totalCost    Float    @default(0)

  @@map("order_materials")
}

enum PaymentMethod {
  pix
  dinheiro
  cartao_credito
  cartao_debito
  transferencia
  outro
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  method    PaymentMethod @default(pix)
  paidAt    DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())

  @@map("payments")
}

model Setting {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storeName           String   @default("Jeh Doces")
  storePhone          String?  @default("(11) 99876-5432")
  pixKey              String?  @default("jehdoces@exemplo.com.br")
  pixKeyType          String?  @default("E-mail")
  defaultProfitMargin Float    @default(100)
  currencySymbol      String   @default("R$")
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

model Commitment {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startsAt])
  @@map("commitments")
}
